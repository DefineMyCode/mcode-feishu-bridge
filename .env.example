# mcode
MCODE_BIN=mcode
MCODE_WORKDIR=/root/your-project
MCODE_PERMISSION=full
MCODE_MODEL=
MCODE_EFFORT=
MCODE_PROMPT_MODE=tui
MCODE_MODE=standard
MCODE_PTC=false
MCODE_DIAGNOSTICS=true
MCODE_DIAGNOSTICS_DIR=/root/mcode-feishu-bridge/data/diagnostics
MCODE_TIMEOUT_MS=1800000
MCODE_MAX_STEPS=0
MCODE_MAX_CONCURRENCY=2

LARK_CLI_BIN=lark-cli
LARK_IDENTITY=bot
LARK_EVENT_KEY=im.message.receive_v1
BOT_NAME=CodeArts
GROUP_REQUIRE_MENTION=true

GROUP_SESSIONS_PER_USER=true
ALLOWED_USER_IDS=
GROUP_POLICY=open
GROUP_RULES=
ALLOWED_CHAT_IDS=

# 路径类配置请一律使用绝对路径
STATE_FILE=/root/mcode-feishu-bridge/data/sessions.json
DEDUP_FILE=/root/mcode-feishu-bridge/data/seen.json
MEDIA_DIR=/root/mcode-feishu-bridge/data/media
MEDIA_RETENTION_DAYS=7
TASK_DB=/root/mcode-feishu-bridge/data/tasks.db
BRIDGE_OUTPUT_DIR=/root/mcode-feishu-bridge/data/output

TASK_AUTO_RETRY=true
TASK_MAX_ATTEMPTS=2
TASK_RETENTION_DAYS=30

BRIDGE_MEDIA=true
TEXT_INJECT_MAX_BYTES=102400
TEXT_INJECT_MAX_CHARS=8000

BRIDGE_REACTIONS=true
REACTION_PROCESSING=Typing
REACTION_FAILURE=CrossMark
BRIDGE_PROGRESS_CARD=true
BRIDGE_COMPLETION_NOTICE=true
BRIDGE_PROGRESS_INTERVAL_MS=5000
BRIDGE_HEARTBEAT_MINUTES=5

TEXT_BATCH_DELAY_MS=600
TEXT_BATCH_MAX_MESSAGES=8
TEXT_BATCH_MAX_CHARS=4000
DEDUP_TTL_MS=86400000
DEDUP_MAX=2048

REPLY_FORMAT=card
REPLY_CHUNK_SIZE=1800
REPLY_MAX_CHUNKS=4
BRIDGE_ACK=true
BRIDGE_ATTACH_LONG_OUTPUT=true
LOG_LEVEL=info

# 定时任务：cron|prompt|chatId，多条用分号分隔
CRON_TASKS=